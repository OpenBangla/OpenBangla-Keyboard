<RCC>
    <qresource prefix="/">
        <file>images/OpenBangla-Keyboard.png</file>
        <file>images/tray.png</file>
        <file>images/icon.png</file>
        <file>images/black/close.svg</file>
        <file>images/black/description.png</file>
        <file>images/black/settings.svg</file>
        <file>images/black/layout.svg</file>
        <file>images/black/layouts.svg</file>
        <file>images/white/close.svg</file>
        <file>images/white/description.png</file>
        <file>images/white/settings.svg</file>
        <file>images/white/layout.svg</file>
        <file>images/white/layouts.svg</file>
        <file>images/black/arrow-down.svg</file>
        <file>images/white/arrow-down.svg</file>
        <file>images/black/translate.svg</file>
        <file>images/white/translate.svg</file>
    </qresource>
    <qresource prefix="/styles">
        <file alias="light.qss">styles/light.qss</file>
        <file alias="dark.qss">styles/dark.qss</file>
    </qresource>
</RCC>
