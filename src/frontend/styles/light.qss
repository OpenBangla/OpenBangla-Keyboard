/* OpenBangla Keyboard — Settings dialog, light theme */

QDialog#SettingsDialog {
    background-color: #ffffff;
}

QDialog#AboutFile {
    background-color: #f1eee8;
}

/* ---- Sidebar ---- */
QWidget#sidebar {
    background-color: #efe7d9;
}

QWidget#sidebar QToolButton {
    color: #4a4a4a;
    background: transparent;
    border: none;
    border-left: 3px solid transparent;
    border-radius: 10px;
    padding: 10px 4px;
    font-size: 13px;
}

QWidget#sidebar QToolButton:hover {
    background: rgba(0, 0, 0, 0.04);
}

QWidget#sidebar QToolButton:checked {
    color: #12897b;
    background: rgba(22, 163, 148, 0.12);
    border-left: 3px solid #16a394;
}

/* ---- Page header ---- */
QLabel[role="title"] {
    color: #2b2b2b;
    font-size: 17px;
    font-weight: 600;
}

/* ---- Card ---- */
QFrame[role="card"] {
    background-color: #ffffff;
    border: 1px solid #e8e6e0;
    border-radius: 12px;
}

QLabel[role="section"] {
    color: #8a8a8a;
    font-size: 12px;
    font-weight: 600;
}

QLabel[role="primary"] {
    color: #333333;
    font-size: 14px;
}

QLabel[role="status"] {
    color: #8a8a8a;
    font-size: 13px;
    min-width: 30px;
}

/* ---- Combo boxes ---- */
QComboBox {
    background-color: #ffffff;
    color: #2b2b2b;
    border: 1px solid #d8d4cc;
    border-radius: 8px;
    padding: 5px 10px;
}

QComboBox:hover {
    border: 1px solid #bdb8ac;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(:/images/black/arrow-down.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #2b2b2b;
    border: 1px solid #d8d4cc;
    border-radius: 8px;
    outline: none;
    selection-background-color: #16a394;
    selection-color: #ffffff;
}

/* ---- Read-only text panels (e.g. developer comment) ---- */
QPlainTextEdit {
    background-color: #f6f4f0;
    color: #333333;
    border: 1px solid #d8d4cc;
    border-radius: 8px;
    padding: 8px 10px;
    selection-background-color: #16a394;
    selection-color: #ffffff;
}

QPlainTextEdit:focus {
    border: 1px solid #bdb8ac;
}

/* ---- Buttons ---- */
QPushButton[role="primary"] {
    background-color: #16a394;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    font-weight: 600;
}

QPushButton[role="primary"]:hover {
    background-color: #148f82;
}

QPushButton[role="primary"]:pressed {
    background-color: #127d72;
}

QPushButton[role="secondary"] {
    background-color: #ececec;
    color: #333333;
    border: 1px solid #d8d4cc;
    border-radius: 8px;
    padding: 8px 20px;
}

QPushButton[role="secondary"]:hover {
    background-color: #e0e0e0;
}

QPushButton[role="secondary"]:pressed {
    background-color: #d5d5d5;
}

QPushButton[role="secondary"]:disabled {
    color: #b0b0b0;
    border: 1px solid #e5e2db;
}

/* Icon-only "About this Layout" button: symmetric padding for a compact square. */
QPushButton#buttonAboutLayout {
    padding: 8px;
}

/* Compact form when the button floats over a single-view layout image. */
QPushButton#buttonAboutLayout[floating="true"] {
    padding: 4px;
}

/* ---- Toggle switch colors (consumed by the custom widget) ---- */
ToggleSwitch {
    qproperty-trackOn: #16a394;
    qproperty-trackOff: #cfd3d8;
    qproperty-handle: #ffffff;
}

/* ---- Layout viewer ---- */
QDialog#LayoutViewer {
    background-color: #ffffff;
}

/* Segmented Normal / AltGr toggle */
QPushButton[role="segment"] {
    background-color: #ececec;
    color: #4a4a4a;
    border: 1px solid #d8d4cc;
    padding: 8px 22px;
    font-weight: 600;
}

QPushButton[role="segment"]:hover {
    background-color: #e0e0e0;
}

QPushButton[role="segment"]:checked {
    background-color: #16a394;
    color: #ffffff;
    border: 1px solid #16a394;
}

QPushButton[role="segment"]:disabled {
    color: #b0b0b0;
    border: 1px solid #e5e2db;
}

QPushButton#viewNormal {
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-right: none;
}

QPushButton#viewAltGr {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
}

/* Natively drawn keyboard palette (consumed by KeyboardWidget) */
KeyboardWidget {
    qproperty-bezel: #e3dccb;
    qproperty-keycap: #ffffff;
    qproperty-keyBorder: #cfcabf;
    qproperty-asciiText: #8a8a8a;
    qproperty-banglaText: #1b3a8f;
    qproperty-modifierText: #7a7a7a;
    qproperty-altGrHighlight: #16a394;
    qproperty-altGrHighlightText: #ffffff;
}
